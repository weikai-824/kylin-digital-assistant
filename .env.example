# 复制为 .env 后按环境修改。勿把填好的 .env 提交到 Git。

# ---- 时区（应用 / MySQL 容器；影响工单 create_time 等）----
TZ=Asia/Shanghai

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=kylin_rag
MYSQL_USER=kylin
MYSQL_PASSWORD=change_me

# ---- 应用数据目录（宿主机路径，映射到容器 /data/kylin）----
KYLIN_ROOT_HOST=./.data/kylin

# ---- Docling 模型目录（宿主机路径，映射到容器 /models/docling）----
# 体积约 1GB+，建议放项目外本机目录，避免占仓库盘、也避免误删重下。
# Windows 示例（正斜杠即可）:
# DOCLING_MODELS_HOST=D:/kylin-models/docling
# DOCLING_ARTIFACTS_PATH=D:/kylin-models/docling
# 默认仍可用项目内路径（首次会按需下载）:
DOCLING_MODELS_HOST=./.data/docling-models
# 本机直接跑 app 时取消下一行注释，并改成与 DOCLING_MODELS_HOST 相同的绝对路径：
# DOCLING_ARTIFACTS_PATH=./.data/docling-models

# 首次启动是否用 deploy/config.example 覆盖 yaml（1=是）
DOCKER_BOOTSTRAP_CONFIG=1

# ---- Langfuse（可选，观测 Trace）----
# 密钥写在 {KYLIN_ROOT}/langfuse_settings.yaml，勿把真实密钥提交 Git

# ---- 开发模式（热重载）----
# 设为 1 时：API uvicorn --reload，WebUI 监听文件变更。
# 本机开发或 docker-compose.dev.yml 叠加时启用；生产部署保持 unset 或 0。
# KYLIN_DEV=1

# 开发入口 scripts/dev.ps1 / Makefile 会叠加开发 overlay。
# 日常请用: make up / .\scripts\dev.ps1 up

# 身份模式覆盖（可选；优先于 oa_settings.yaml 的 identity_mode）
# fixed_dev = 无工号登录，固定 userid 供长期记忆；oa_login = 侧边栏工号登录
# KYLIN_IDENTITY_MODE=fixed_dev
# 多人本地互不抢记忆时可覆盖固定 userid
# KYLIN_DEV_USER_ID=dev_local

# ---- DeepSeek（公网 API，走 https://api.deepseek.com/v1）----
# 用于把默认 LLM 切到 deepseek-v4-flash（planner / 流式生成），
# 跑 oa-llm（QwQ-32B-AWQ）作降级。
# 真 key 写在 .env（已被 .gitignore），勿把填好的 .env 提交到 Git。
DEEPSEEK_API_KEY=

